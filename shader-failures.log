    vec2 off = tc - center;
    float maxR = length(vec2(0.5));
    float r = length(off);
    float nr = r / maxR;
    float ang = atan(off.y, off.x);

    float dr = nr + uDistortion * (nr * nr);
    dr = clamp(dr, 0.0, 1.0) * maxR;
    vec2 d = center + dr * vec2(cos(ang), sin(ang));
    vec2 dp = d - center;

    float tr = time_f * uRandRate;
    float tp = time_f * uPhaseRate;
    float nR = floor(tr);
    float nP = floor(tp);
    float ar = fract(tr);
    float ap = fract(tp);

