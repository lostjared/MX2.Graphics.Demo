    vec2 texelSize = 1.0 / iResolution;
    vec3 result = vec3(0.0);
    float weight[5];
    weight[0] = 0.227027;
    weight[1] = 0.1945946;
    weight[2] = 0.1216216;
    weight[3] = 0.054054;
    weight[4] = 0.016216;
    for (int i = -4; i <= 4; i++) {
        result += texture(samp, uv + vec2(float(i) * texelSize.x, 0.0)).rgb * weight[abs(i)];
    }
    for (int j = -4; j <= 4; j++) {
