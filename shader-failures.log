uniform float uRotateSpeed = 1.0;
uniform float uWarpSpeed = 0.1;
uniform float uRandRate = 0.2;
uniform float uPhaseRate = 0.1;

float pingPong(float x, float len) {
    float m = mod(x, len * 2.0);
    return abs(m - len);
}

float rand(float n) {
    return fract(sin(n) * 43758.5453123);
}

void main(void) {
