    vec3 diamondColor = hash3(c);
    vec3 finalColor = isEvenDiamond ? diamondColor * 0.8 : diamondColor * 0.5;
    color = xor_RGB(vec4(finalColor, 1.0), texture(samp, tc));
    
}


